# Generated by Codex for LogstoneDB. Reviewed by: (pending)

GO ?= go
RAFT_PACKAGE := github.com/aadityaadhikari/logstonedb/internal/raft

.PHONY: check vet test-race check-raft-stdlib

check: vet test-race check-raft-stdlib

vet:
	$(GO) vet ./...

test-race:
	$(GO) test -race ./...

check-raft-stdlib:
	@nonstdlib="$$( $(GO) list -deps -f '{{if and (not .Standard) (ne .ImportPath "$(RAFT_PACKAGE)")}}{{.ImportPath}}{{end}}' ./internal/raft | sed '/^$$/d' )"; \
	if [ -n "$$nonstdlib" ]; then \
		echo "internal/raft has non-standard-library dependencies:" >&2; \
		echo "$$nonstdlib" >&2; \
		exit 1; \
	fi; \
	echo "internal/raft: standard-library-only dependencies verified"
