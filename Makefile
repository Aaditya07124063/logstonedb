# Generated by Codex for LogstoneDB. Reviewed by: (pending)

GO ?= go
RAFT_PACKAGE := github.com/Aaditya07124063/logstonedb/internal/raft
SIMULATION_PACKAGE := github.com/Aaditya07124063/logstonedb/internal/simulation

.PHONY: check vet test-race check-raft-boundaries

check: vet test-race check-raft-boundaries

vet:
	$(GO) vet ./...

test-race:
	$(GO) test -race ./...

check-raft-boundaries:
	@nonstdlib="$$( $(GO) list -deps -f '{{if and (not .Standard) (ne .ImportPath "$(RAFT_PACKAGE)") (ne .ImportPath "$(SIMULATION_PACKAGE)")}}{{.ImportPath}}{{end}}' ./internal/raft ./internal/simulation | sed '/^$$/d' )"; \
	if [ -n "$$nonstdlib" ]; then \
		echo "internal/raft or internal/simulation has non-standard-library dependencies:" >&2; \
		echo "$$nonstdlib" >&2; \
		exit 1; \
	fi
	@raft_imports="$$( $(GO) list -f '{{range .Imports}}{{printf "%s\n" .}}{{end}}' ./internal/raft )"; \
	banned="$$( printf '%s\n' "$$raft_imports" | grep -E '^(time|os|os/.*|net|net/.*|io/fs|syscall|math/rand|sync|sync/.*)$$' || true )"; \
	if [ -n "$$banned" ]; then \
		echo "internal/raft imports forbidden packages:" >&2; \
		echo "$$banned" >&2; \
		exit 1; \
	fi
	@raft_imports="$$( $(GO) list -f '{{range .Imports}}{{printf "%s\n" .}}{{end}}' ./internal/raft )"; \
	if printf '%s\n' "$$raft_imports" | grep -Fqx "$(SIMULATION_PACKAGE)"; then \
		echo "internal/raft must not import internal/simulation" >&2; \
		exit 1; \
	fi
	@if rg -n --glob '*.go' '(^|[;{}])[[:space:]]*go[[:space:]]+' internal/raft; then \
		echo "internal/raft must not contain goroutine statements" >&2; \
		exit 1; \
	fi
	@echo "internal/raft boundaries verified: stdlib-only, no forbidden packages, no goroutines"
